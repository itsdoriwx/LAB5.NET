<Window x:Class="StudentRatingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Облік рейтингу студентів" Height="660" Width="980"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F4F5F7"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2D3748"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EDF2F7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#A0AEC0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0066CC"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0052A3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0052A3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#003D7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- дані студента (введення) -->
        <GroupBox Header="Новий запис: дані студента" Grid.Row="0" Margin="0,0,0,12" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ПІБ:" VerticalAlignment="Center" Margin="0,0,6,0" Grid.Column="0"/>
                <TextBox x:Name="TxtFullName" VerticalAlignment="Center" Margin="0,0,12,0" Grid.Column="1"/>

                <TextBlock Text="Курс:" VerticalAlignment="Center" Margin="0,0,6,0" Grid.Column="2"/>
                <TextBox x:Name="TxtCourse" VerticalAlignment="Center" Margin="0,0,12,0" Grid.Column="3"/>

                <TextBlock Text="Група:" VerticalAlignment="Center" Margin="0,0,6,0" Grid.Column="4"/>
                <TextBox x:Name="TxtGroup" VerticalAlignment="Center" Margin="0,0,12,0" Grid.Column="5"/>

                <TextBlock Text="Рейтинг:" VerticalAlignment="Center" Margin="0,0,6,0" Grid.Column="6"/>
                <TextBox x:Name="TxtRating" VerticalAlignment="Center" Margin="0,0,12,0" Grid.Column="7"/>

                <Button Content="Додати" Click="BtnAddStudent_Click" 
                        Style="{StaticResource AccentButtonStyle}" Padding="16,6" Grid.Column="8"/>
            </Grid>
        </GroupBox>

        <!-- список + панель керування -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <!-- список -->
            <GroupBox Grid.Column="0" Margin="0,0,12,0" Padding="8">
                <GroupBox.Header>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Рейтинговий список студентів" VerticalAlignment="Center" FontWeight="SemiBold"/>

                        <!-- сортування, фільтрація -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- сортування -->
                            <Border x:Name="BorderActiveSort" Visibility="Collapsed" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtActiveSortInfo" Text="Сортування: за рейтингом" FontSize="11.5" FontWeight="Normal" Foreground="#475569" VerticalAlignment="Center"/>
                                    <Button Content="✕" Click="BtnClearSortBadge_Click" Margin="6,0,0,0" Background="Transparent" BorderThickness="0" Foreground="#64748B" FontSize="10" FontWeight="Normal" Cursor="Hand" Padding="2,0"/>
                                </StackPanel>
                            </Border>

                            <!-- фільтрація -->
                            <Border x:Name="BorderActiveFilter" Visibility="Collapsed" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtActiveFilterInfo" Text="Група: КН-33" FontSize="11.5" FontWeight="Normal" Foreground="#475569" VerticalAlignment="Center"/>
                                    <Button Content="✕" Click="BtnClearFilterBadge_Click" Margin="6,0,0,0" Background="Transparent" BorderThickness="0" Foreground="#64748B" FontSize="10" FontWeight="Normal" Cursor="Hand" Padding="2,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </GroupBox.Header>

                <ListBox x:Name="LstStudents" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemCard" Background="#FFFFFF" BorderBrush="#E2E8F0" 
                                                BorderThickness="1" CornerRadius="6" Padding="12,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemCard" Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter TargetName="ItemCard" Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemCard" Property="Background" Value="#EFF6FF"/>
                                                <Setter TargetName="ItemCard" Property="BorderBrush" Value="#93C5FD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <!-- картка студента -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- курс -->
                                    <Border Background="#FCE7F3" CornerRadius="4" Padding="8,4" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Course, StringFormat='{}{0} курс'}" FontSize="12" Foreground="#831843" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- група -->
                                    <Border Background="#E0E7FF" CornerRadius="4" Padding="8,4" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Group}" FontSize="12" Foreground="#3730A3" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- блок рейтингу -->
                                    <Border Background="#DCFCE7" BorderThickness="0" CornerRadius="4" Padding="10,4" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding RatingScore, StringFormat='{}{0:F2}'}"  FontWeight="Bold" FontSize="12.5" Foreground="#15803D"/>
                                    </Border>
                                </StackPanel>

                                <!-- ПІБ -->
                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="13.5" 
                                           Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <!-- сортування та фільтрація -->
            <GroupBox Header="Керування списком" Grid.Column="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="Сортування:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Button Content="За рейтингом" Click="BtnSortByRating_Click"  Margin="0,0,0,8" Padding="8,6"/>
                    <Button Content="За алфавітом" Click="BtnSortByName_Click" Margin="0,0,0,16" Padding="8,6"/>

                    <Separator Margin="0,0,0,12" Background="#E2E8F0"/>

                    <TextBlock Text="Фільтрація за групою:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtFilterGroup" Margin="0,0,0,8" Padding="6,4"/>

                    <Button Content="Застосувати фільтр" Click="BtnFilter_Click" Margin="0,0,0,6" Padding="8,6"/>
                    <Button Content="Скинути фільтр" Click="BtnResetFilter_Click"  Padding="8,6"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- панель дій -->
        <GroupBox Header="Дії зі списком та файлами" Grid.Row="2" Padding="12,10">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Видалити обраного студента" 
                        Click="BtnRemoveSelected_Click" 
                        Style="{StaticResource AccentButtonStyle}"
                        MinHeight="38" Padding="20,10"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Зберегти список у файл" Click="BtnSaveToFile_Click" MinHeight="38" Padding="20,10" Margin="0,0,10,0"/>
                    <Button Content="Завантажити список із файлу" Click="BtnLoadFromFile_Click"  MinHeight="38" Padding="20,10"/>
                </StackPanel>
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>